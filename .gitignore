# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Esoh Studio
# Generated output is regenerable and large, so it stays out of git — with one
# exception. The exemplars are what the Style Library was tuned against (D89);
# losing them means re-deriving the house style, not re-running a generation.
/storage
!/storage/exemplars
!/storage/exemplars/**
.env.local

# Database dumps — copies, not backups, until they leave this machine.
/backups
