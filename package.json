{
  "name": "esoh-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/migrate.mjs seed",
    "typecheck": "tsc --noEmit",
    "db:import": "node --env-file=.env.local scripts/import-sheets.mjs",
    "db:dump": "node --env-file=.env.local scripts/db-dump.mjs",
    "prompt:preview": "tsx --env-file=.env.local scripts/preview-prompt.mts",
    "printify:areas": "node --env-file=.env.local scripts/printify-print-areas.mjs",
    "doc:print": "node scripts/print-doc.mjs"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "next": "16.3.1",
    "openai": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
